APP_NAME=auraERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Database backups (Admin → Settings → Backup Database)
SECURITY_BACKUP_ENABLED=true
SECURITY_BACKUP_SCHEDULE_AT=02:00
SECURITY_BACKUP_RETENTION_DAYS=14
SECURITY_BACKUP_RETENTION_COUNT=30
SECURITY_BACKUP_COMPRESS=true
SECURITY_BACKUP_PREFER_NATIVE=true
# SECURITY_BACKUP_PATH=
# SECURITY_BACKUP_RESTORE_CONFIRMATION=RESTORE
# Leave empty to auto-disable restore in production:
# SECURITY_BACKUP_ALLOW_RESTORE=

# Demo accounts (set false on real production go-live)
SECURITY_DEMO_ACCOUNTS_ALLOWED=true
# SECURITY_DEMO_ACCOUNT_EMAILS=hrd@opsora.my.id,karyawan@opsora.my.id

# Login rate limit + IP block (Admin → Settings → Blocked IPs)
SECURITY_LOGIN_PROTECTION_ENABLED=true
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=1
SECURITY_LOGIN_BLOCK_AFTER_FAILURES=10
SECURITY_LOGIN_FAILURE_WINDOW_MINUTES=15
SECURITY_LOGIN_BLOCK_MINUTES=30
SECURITY_LOGIN_IP_WHITELIST=127.0.0.1,::1

NATIVEPHP_APP_ID=com.example.aureuserp.barcode
NATIVEPHP_APP_VERSION=DEBUG
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_START_URL=https://your-domain.tld/admin/barcode?nativephp=1
